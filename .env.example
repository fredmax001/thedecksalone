# Frontend
VITE_API_URL=http://localhost:5002/api

# Backend
PORT=5002
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
JWT_SECRET=

# Google OAuth (backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP) - required for password reset, welcome, OTP and admin emails.
# Hostinger example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465            # 465 for SSL, 587 for STARTTLS
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=you@yourdomain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@deck.salone

# Optional: override default sender / support addresses
# SUPPORT_EMAIL=support@decksalone.com
# ADMIN_EMAIL=admin@decksalone.com
# ADMIN_NOTIFY_EMAIL=contact@decksalone.com

# Storage (S3-compatible, e.g. Cloudflare R2)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_URL=
# API_URL=
# S3_FORCE_PATH_STYLE=true

# Local file uploads
# UPLOADS_DIR=./uploads
# MAX_IMAGE_UPLOAD_MB=10
# MAX_DOCUMENT_UPLOAD_MB=10
# MAX_AUDIO_UPLOAD_MB=300

# Redis (optional, for caching / rate limiting)
# REDIS_URL=redis://localhost:6379

# External APIs
# RAPIDAPI_KEY=

# Ticket QR encryption (optional; falls back to JWT_SECRET then a hard-coded dev value)
# TICKET_QR_SECRET=

# Monitoring
# METRICS_TOKEN=

# Logging
# LOG_LEVEL=info

# Subscriptions
# SUBSCRIPTION_PAYMENT_METHOD=Orange Money
# PLATFORM_PAYMENT_NUMBER=+23272011156
# PLATFORM_WHATSAPP_NUMBER=+23272011156
# PRO_SUBSCRIPTION_PRICE=200
# LEGEND_SUBSCRIPTION_PRICE=350
# SUBSCRIPTION_CURRENCY=SLE

# Push notifications (Firebase Cloud Messaging)
# Path to the Firebase service-account JSON key on the server.
# When unset, push notifications are silently skipped (in-app + local notifications still work).
# FCM_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
# FCM_PROJECT_ID=your-firebase-project-id

# App version check (keep APP_LATEST_VERSION_CODE in sync with versionCode in android/app/build.gradle)
# APP_LATEST_VERSION=1.1.0
# APP_LATEST_VERSION_CODE=11
# APP_RELEASE_NOTES=Bug fixes and performance improvements.
# APP_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=decksalone.com
# APP_APK_URL=/api/app/download
# APP_APK_FILENAME=DeckSalone-1.1.0.apk

# Seed / admin scripts (only needed for prisma/seed.ts and helper scripts)
# SEED_ADMIN_EMAIL=admin@decksalone.com
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
# RESET_PASSWORD=
# KEEP_EMAIL=
