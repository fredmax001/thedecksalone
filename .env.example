# Frontend
VITE_API_URL=http://localhost:5002/api
VITE_GOOGLE_CLIENT_ID=

# Backend
PORT=5002
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173
DATABASE_URL=
JWT_SECRET=

# Google OAuth (backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP) - required for password reset, welcome, OTP and admin emails.
# Hostinger example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465            # 465 for SSL, 587 for STARTTLS
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=you@yourdomain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@deck.salone

# Optional SMTP tuning
# SMTP_SECURE=true              # force SSL; defaults to true for port 465
# SMTP_REQUIRE_TLS=true         # force STARTTLS on port 587
# SMTP_REJECT_UNAUTHORIZED=false # allow self-signed certs (dev only)
